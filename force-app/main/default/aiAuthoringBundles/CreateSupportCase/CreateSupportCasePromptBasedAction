system:
    instructions: |You are a support assistant who helps users log support cases.
                   Keep replies short. Always confirm the case number after a case
                   is created.

    messages:
        welcome: "Hi! I can help you log a support case. Tell me what's going wrong."
        error: "Something went wrong while creating your case."

config:
    agent_label: "Create Support Case"
    agent_template: "SvcCopilotTmpl__AgentforceServiceAgent"
    developer_name: "CreateSupportCase"
    description: "Creates a support case via a Flow action, taking a required subject and optional description"

access:
    default_agent_user: "create_support_case@00dgk000000jzmx1642579533.ext"

variables:
    subject: mutable string = ""
        description: "Subject of Case"
        label: "subject"
        visibility: "External"
    issue_description: mutable string = ""
        description: "Optional longer description of the issue"
        label: "issue description"
        visibility: "External"
    case_number: mutable string = ""
        description: "Case number returned from the successful create"
        label: "case number"
    error_message: mutable string = ""
        description: "Error returned when the case creation failed."
        label: "error message"
        visibility: "External"
    CaseSummary: mutable string
        description: "Case Summary"
        label: "CaseSummary"
        visibility: "External"
    self_help_tips: mutable string = ""
        description: "tips from prompt template for self help"
        label: "self help tips"
        visibility: "External"
    create_confirmed: mutable boolean = False
        description: "True only after the user says they still want a Case logged"
        label: "create confirmed"
        visibility: "External"
    create_declined: mutable boolean = False
        description: "True after the user says they do not want a Case logged"
        label: "create declined"
        visibility: "External"

language:
    additional_locales: "en_GB"
    default_locale: "en_US"
    all_additional_locales: False

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the user and determine the appropriate subagent based on user input"
    model_config:
        model: "model://sfdc_ai__DefaultGPT41"
    reasoning:
        instructions: ->
            | Select the best tool to call based on conversation history and user's intent.
        actions:
            go_to_Case_Management: @utils.transition to @subagent.Case_Management
                description: "Collects a subject, optionally a longer description, and creates a Case via Flow"

subagent Case_Management:
    label: "Case Management"
    description: |

        Collects a subject, optionally a longer description, and creates a Case via Flow
    reasoning:
        instructions: ->
            |Help the user log a support case. Be concise. Do not ask for everything at once.
            if @variables.subject == "":
                |if the user described the issue use {!@actions.set_subject}to save the short subject. otherwise ask for a short subject
            if @variables.subject != "" and @variables.case_number == "" and @variables.self_help_tips == "":
                |a longer description is optional - do not insist. if user provided then save the issue description using {!@actions.set_description}to save it.
                |Use {!@actions.suggest_case_help}to suggest 2 or 3 thing the user can try first.
            if @variables.self_help_tips != "" and @variables.create_confirmed == False and @variables.create_declined == False:
                |share the things to try first : {!@variables.self_help_tips}. Ask if they still want to log a case. If they said yes use {!@actions.Case_Confirmation_Creation}, however they they said no use {!@actions.Create_Case_Declined}. Do not log a case until they say yes
            if @variables.create_confirmed == True and @variables.case_number == "":
                |Use the {!@actions.create_case_action}to log the case.
                |
            if @variables.create_declined == True:
                |they chose not to log a case. confirm that, and say they can come back if the issue continues
            |Once the {!@variables.case_number}is available share the {!@variables.CaseSummary}. Thanks the user for logging the case. Make sure you are not asking any other followup
            if @variables.error_message != "":
                |Case creation failed. Apologize , share the {!@variables.error_message}, and ask them to retry.
            |
        actions:
            set_subject: @utils.setVariables
                description: "save the case subject"
                with subject = ...
            set_description: @utils.setVariables
                description: "save the issue description"
                with issue_description = ...
            suggest_case_help: @actions.suggest_case_help
                with "Input:Case_Description" = @variables.issue_description
                with "Input:Case_Subject" = @variables.subject
                with outputLanguage = ...
                with isPreviewOnly = ...
                set @variables.self_help_tips = @outputs.promptResponse
            Case_Confirmation_Creation: @utils.setVariables
                description: "Case Confirmation Creation"
                with create_confirmed = True
            Create_Case_Declined: @utils.setVariables
                description: "Create Case Declined"
                with create_declined = True
            create_case_action: @actions.create_case_action
                with inpCaseSubject = @variables.subject
                with inpDescription = @variables.issue_description
                set @variables.case_number = @outputs.outCaseNumber
                set @variables.error_message = @outputs.outErrorMessage
                run @actions.Case_details_by_number
                    with caseNumber = @variables.case_number
                    set @variables.CaseSummary = @outputs.caseSummary
    actions:
        create_case_action:
            label: "create case action"
            description: "create case record based on subject and optional description"
            target: "flow://Case_Creation_Action_For_Agent"
            inputs:
                inpCaseSubject: string
                    label: "inpCaseSubject"
                    description: "Case Subject"
                    is_required: True
                inpDescription: string
                    label: "inpDescription"
                    description: "Optional description of case"
                    is_required: False
            outputs:
                outCaseNumber: string
                    label: "outCaseNumber"
                    description: "Case Number of newly created case"
                    is_displayable: True
                    filter_from_agent: False
                outErrorMessage: string
                    label: "outErrorMessage"
                    description: "Error message if case creation failed"
                    is_displayable: True
                    filter_from_agent: False
        Case_details_by_number:
            label: "Case details by number"
            description: |Invocable Apex that looks up a Case by Case Number and
                          returns a one-line summary. Used as the Apex-backed action
                          in the CreateSupportCase agent, after Flow creates the Case.
                          Read-only — no DML.
            target: "apex://CaseDetailsByNumberService"
            inputs:
                caseNumber: string
                    label: "Case Number"
                    description: "The Case Number to look up (for example 00001012)"
                    is_required: True
            outputs:
                caseSummary: string
                    label: "Case Summary"
                    description: "One-line summary of the Case for the agent to read back"
                    is_displayable: True
                    filter_from_agent: False
        suggest_case_help:
            label: "suggest case help"
            description: "Suggest 2 or 3 things the user can try from the collected subject and description"
            target: "generatePromptResponse://Suggest_Case_Self_Help"
            inputs:
                "Input:Case_Description": string
                    label: "Case Description"
                    description: "Optional description of case"
                    is_required: False
                "Input:Case_Subject": string
                    label: "Case Subject"
                    description: "Case Subject"
                    is_required: True
                outputLanguage: string
                    label: "Output language"
                    description: "Optional. Specify the response language using the appropriate two-character language code or five-character locale code (for example, en_US, en_GB, es, es_MX)."
                    is_required: False
                isPreviewOnly: boolean
                    label: "Preview Only"
                    description: "Resolves the prompt template without generating an LLM response."
                    is_required: False
            outputs:
                promptResponse: string
                    label: "Prompt Response"
                    description: "Two or three short troubleshooting steps"
                    is_displayable: True
                    filter_from_agent: False
                generationId: string
                    label: "Prompt Generation ID"
                    description: "The unique identifier for the prompt generation associated with this action invocation."
                    is_displayable: False
                    filter_from_agent: False
